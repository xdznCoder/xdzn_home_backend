# ============================================
# 环境变量模板 —— 复制为 .env 后填写真实值
#   cp .env.example .env   (Windows: copy .env.example .env)
# .env 不会被提交到 Git（已在 .gitignore 排除）
# ============================================

# ── MySQL 数据库 ──
DB_USER=root
DB_PASSWORD=你的数据库密码

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Sa-Token JWT 密钥（生产必须更换）──
JWT_SECRET=dev-secret-change-in-production

# ── 允许跨域的前端地址 ──
FRONTEND_URL=http://localhost:3000

# ── 招新报名通知邮箱（可选）──
JOIN_NOTIFY_EMAIL=

# ── GitHub 图床（成员头像/项目封面）──
# 在 https://github.com/settings/tokens 创建带 repo 权限的 PAT
GITHUB_TOKEN=你的GitHubToken
GITHUB_REPO=xdznCoder/xdzn-images
GITHUB_IMG_PATH=images
GITHUB_IMG_BRANCH=main

# ── 文件上传（内部附件）──
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=20971520
